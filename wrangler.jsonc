{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nocoder-lab",
  "main": "backend/src/index.ts",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "AGENT_QUEUE", "class_name": "AgentQueue" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AgentQueue"] }],
  "observability": { "enabled": true },
  "vars": {
    "GITHUB_OWNER": "jiangfengwhu",
    "GITHUB_REPO": "no-coder",
    "GITHUB_BRANCH": "main",
    "JULES_SOURCE": "",
    "DEPLOY_WORKFLOW": "deploy.yml",
    "AUTO_MERGE": "true",
    "APP_COMMIT": "local"
  }
}
