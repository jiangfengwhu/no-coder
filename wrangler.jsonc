{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nocoder-lab",
  "main": "backend/src/index.ts",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "AGENT_QUEUE", "class_name": "AgentQueue" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AgentQueue"] }],
  "observability": { "enabled": true },
  "vars": {
    "GITHUB_OWNER": "jiangfengwhu",
    "GITHUB_REPO": "no-coder",
    "GITHUB_BRANCH": "main",
    // Fill the exact source name returned by the Jules Sources API.
    // Example format only: sources/your-repository-source-id
    "JULES_SOURCE": "",
    "DEPLOY_WORKFLOW": "deploy.yml",
    "DEPLOY_MODE": "jules",
    "APP_URL": "https://nocoder-lab.809740942.workers.dev",
    "AUTO_MERGE": "true",
    "APP_COMMIT": "local"
  }
}
