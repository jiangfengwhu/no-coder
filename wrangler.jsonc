{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nocoder-lab",
  "main": "backend/src/index.ts",
  "compatibility_date": "2026-10-30",
  "routes": [{ "pattern": "nocoder.297782.xyz/*", "zone_name": "297782.xyz" }],
  "workers_dev": true,
  "services": [{ "binding": "CANVAS", "service": "nocoder-canvas" }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "AGENT_QUEUE", "class_name": "AgentQueue" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AgentQueue"] }],
  "observability": { "enabled": true },
  "vars": {
    "GITHUB_OWNER": "jiangfengwhu",
    "GITHUB_REPO": "no-coder-canvas",
    "GITHUB_BRANCH": "main",
    "DEPLOY_MODE": "jules",
    "CANVAS_URL": "https://nocoder-canvas.809740942.workers.dev",
    "APP_URL": "https://nocoder.297782.xyz",
    "AUTO_MERGE": "true",
    "APP_COMMIT": "local"
  }
}
