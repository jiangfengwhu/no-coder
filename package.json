{
  "name": "nocoder-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "vite --host 127.0.0.1",
    "dev:backend": "wrangler dev --port 8787",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build",
    "check": "npm run typecheck && npm test && npm run build",
    "deploy": "npm run build && wrangler deploy",
    "deploy:jules": "node scripts/deploy-jules.mjs",
    "deploy:check": "wrangler deploy --dry-run --outdir .worker-build",
    "setup:admin": "node scripts/bootstrap-admin.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261030.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.0",
    "wrangler": "^4.156.0"
  }
}
